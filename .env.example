# Copy this file to .env and fill in your values. .env is gitignored.
#
# The agent uses the OpenAI-compatible interface. Set OPENAI_BASE_URL to your
# model endpoint:
#   - OpenAI:            (leave OPENAI_BASE_URL unset)
#   - Google Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   - a gateway/proxy:   the base URL your provider gives you
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGENT_MODEL=gemini-2.0-flash
# AGENT_MAX_ITERATIONS=8
# AGENT_TIMEOUT=15
